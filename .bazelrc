common --cxxopt=-std=c++20
common --host_cxxopt=-std=c++20

# GNU ld 2.47 segfaults when Bazel passes --start-lib/--end-lib.
common --features=-supports_start_end_lib
common --host_features=-supports_start_end_lib

# AddressSanitizer + UndefinedBehaviorSanitizer: bazel test --config=asan //...
build:asan --strip=never
build:asan --copt=-fsanitize=address,undefined
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-fno-sanitize-recover=all
build:asan --linkopt=-fsanitize=address,undefined
# GCC's UBSan makes function pointer comparisons non-constant, which breaks
# Abseil's hash tables. Skip UBSan (but not ASan) in external code.
build:asan --per_file_copt=external/.*@-fno-sanitize=undefined

# ThreadSanitizer, for the multithreaded server and MCTS code:
#   bazel test --config=tsan //server/...
build:tsan --strip=never
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --linkopt=-fsanitize=thread
